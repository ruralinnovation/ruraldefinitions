Package: ruraldefinitions
Type: Package
Title: Data package for accessing and manipulating rural definitions
Version: 0.2.0
Authors@R: c(
    person(
      "Camden", "Blatchly",
      role = "aut"
    ),
    person(
      "Drew", "Rosebush",
      email = "drew.rosebush@ruralinnovation.us",
